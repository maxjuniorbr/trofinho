# Expo public values are bundled into the app. Do not put service-role keys,
# SMTP passwords, or any backend-only secret here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_SENTRY_DSN=

# EAS build secret. Store the base64 value in EAS/CI, not in .env.local.
# GOOGLE_SERVICES_JSON=

# Local Maestro E2E credentials.
# MAESTRO_EMAIL=
# MAESTRO_PASSWORD=
# MAESTRO_REGISTER_PASSWORD=

# Direct Postgres connection string used ONLY by SQL contract tests under
# `tests/contract/`. Required only when running those tests locally; in CI
# they are skipped when this variable is absent (see `.github/workflows/ci.yml`).
# Use a non-pooled, transaction-capable connection (e.g. the Supabase
# "Direct connection" string) so transactional rollback works as expected.
# SUPABASE_DB_URL=postgres://postgres:<password>@<host>:5432/postgres?sslmode=require
