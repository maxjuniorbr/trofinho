# Supabase — banco de dados e autenticação
EXPO_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=SEU_ANON_KEY_AQUI
SUPABASE_SERVICE_ROLE_KEY=SEU_SERVICE_ROLE_KEY_AQUI

# Supabase Management API — scripts de configuração (email templates, etc.)
SUPABASE_ACCESS_TOKEN=SEU_ACCESS_TOKEN_AQUI

# SonarCloud — análise de qualidade de código
SONAR_TOKEN=SEU_SONAR_TOKEN_AQUI

# Sentry — monitoramento de erros e performance
EXPO_PUBLIC_SENTRY_DSN=SEU_SENTRY_DSN_AQUI
SENTRY_AUTH_TOKEN=SEU_SENTRY_AUTH_TOKEN_AQUI
SENTRY_AUTH_PERSONAL_TOKEN=SEU_SENTRY_PERSONAL_TOKEN_AQUI

# Expo — autenticação com EAS
EXPO_AUTH_TOKEN=SEU_EXPO_AUTH_TOKEN_AQUI

# Jules (Google) — agente de código AI
JULES_API_KEY=SEU_JULES_API_KEY_AQUI

# Maestro — credenciais para testes E2E
MAESTRO_EMAIL=SEU_EMAIL_DE_TESTE@example.com
MAESTRO_PASSWORD=SUA_SENHA_DE_TESTE
MAESTRO_REGISTER_PASSWORD=SUA_SENHA_DE_CADASTRO

# Resend — SMTP para e-mails transacionais (confirmação, recuperação de senha, etc.)
RESEND_API_KEY=SEU_RESEND_API_KEY_AQUI
