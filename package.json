{
  "name": "trofinho",
  "version": "1.0.1",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "tunnel": "expo start --tunnel",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "android:devices": "adb devices",
    "android:screenshot": "mkdir -p .tmp && adb exec-out screencap -p > .tmp/screen.png",
    "android:ui": "mkdir -p .tmp && adb shell uiautomator dump /sdcard/window.xml && adb pull /sdcard/window.xml .tmp/window.xml",
    "android:logs": "adb logcat *:S ReactNative:V ReactNativeJS:V",
    "android:logcat": "adb logcat | grep -E 'ReactNative|ReactNativeJS'",
    "test:e2e": "maestro test -e MAESTRO_EMAIL=$MAESTRO_EMAIL -e MAESTRO_PASSWORD=$MAESTRO_PASSWORD .maestro/login.yaml && maestro test -e MAESTRO_EMAIL=$MAESTRO_EMAIL -e MAESTRO_PASSWORD=$MAESTRO_PASSWORD .maestro/logout.yaml && maestro test -e MAESTRO_EMAIL=$MAESTRO_EMAIL .maestro/login-wrong-password.yaml && maestro test .maestro/login-empty-fields.yaml",
    "test:e2e:login": "maestro test -e MAESTRO_EMAIL=$MAESTRO_EMAIL -e MAESTRO_PASSWORD=$MAESTRO_PASSWORD .maestro/login.yaml",
    "test:e2e:logout": "maestro test -e MAESTRO_EMAIL=$MAESTRO_EMAIL -e MAESTRO_PASSWORD=$MAESTRO_PASSWORD .maestro/logout.yaml",
    "test:e2e:create-account": "maestro test -e MAESTRO_REGISTER_PASSWORD=$MAESTRO_REGISTER_PASSWORD .maestro/create-account.yaml",
    "test:e2e:login-wrong-password": "maestro test -e MAESTRO_EMAIL=$MAESTRO_EMAIL .maestro/login-wrong-password.yaml",
    "test:e2e:login-empty-fields": "maestro test .maestro/login-empty-fields.yaml",
    "db:diff": "supabase db diff",
    "db:push": "supabase db push",
    "db:types": "npx supabase gen types typescript --linked > src/types/database.types.ts",
    "db:seed": "supabase db query --linked -f temp/seed-test-data.sql",
    "build": "EAS_BUILD_NO_EXPO_GO_WARNING=true npx eas-cli@latest build --profile preview --platform android",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-community/slider": "^5.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@sentry/react-native": "^8.7.0",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.106.2",
    "@tanstack/react-query": "^5.100.14",
    "expo": "~56.0.6",
    "expo-application": "~56.0.3",
    "expo-clipboard": "~56.0.3",
    "expo-constants": "~56.0.16",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.16",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.7",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.9",
    "expo-image-manipulator": "~56.0.15",
    "expo-image-picker": "~56.0.14",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.12",
    "expo-notifications": "~56.0.14",
    "expo-router": "~56.2.7",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.17",
    "lucide-react-native": "^1.16.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "^2.31.2",
    "react-native-reanimated": "^4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "^4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "^0.8.3"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/pg": "^8.20.0",
    "@types/react": "~19.2.10",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~56.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.10.1",
    "fast-check": "^4.8.0",
    "pg": "^8.21.0",
    "prettier": "^3.8.3",
    "supabase": "^2.101.0",
    "test-renderer": "^1.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "@xmldom/xmldom": "^0.8.13",
    "brace-expansion@^1.0.0": "^1.1.16",
    "brace-expansion@^5.0.0": "^5.0.9",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.23",
    "shell-quote": "^1.9.0",
    "undici": "^6.28.0",
    "uuid": "^11.1.1"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  }
}
